{
  "expo": {
    "name": "{{projectName}}",
    "slug": "{{projectSlug}}",
    "scheme": "{{projectSlug}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "web": { "bundler": "metro", "output": "static" }
  }
}
