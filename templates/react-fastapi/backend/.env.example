# The app reads configuration from the environment; it does not load dotenv
# files. In Zelyq these are set for you — the Backend panel writes them, and the
# defaults below are what a project starts with. Outside Zelyq, set them in your
# deployment's environment or secret store.

# Persistence. The default is this project's own SQLite file, created under
# ZELYQ_DATA_DIR — no setup, and it is not part of the source tree. Point
# DATABASE_URL at PostgreSQL or MySQL to use your own database instead.
DATABASE_ENGINE=sqlite
DATABASE_URL=
DATABASE_OWNERSHIP=application
DATABASE_READ_ONLY=false
ZELYQ_DATA_DIR=../.runtime-data

# Only for a database somebody else owns: the tables discovery may describe.
DATABASE_TABLES=
DATABASE_SCHEMA=
# A CA bundle, when the database is behind a private or self-signed CA. TLS
# verification is always on; this says who to trust.
DATABASE_SSL_ROOT_CERT=

# Application sign-in. Until this is configured, routes that require a user
# refuse the request rather than becoming public. Use an API-specific audience:
# an OIDC ID token is not an API access token.
AUTH_MODE=none
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
