#!/usr/bin/env node
import { chromium } from 'playwright'
import { mkdir } from 'node:fs/promises'
import path from 'node:path'

const url = process.argv[2]
const out = process.argv[3] ?? 'artifacts/design-review'

if (!url) {
  console.error('Usage: capture-design <url> [output-directory]')
  console.error('Requires Playwright: npm install -D playwright')
  process.exit(2)
}

const viewports = [
  ['mobile', 390, 844],
  ['tablet', 768, 1024],
  ['desktop', 1440, 1000],
]

await mkdir(out, { recursive: true })

const browser = await chromium.launch({ headless: true })

for (const [name, width, height] of viewports) {
  const page = await browser.newPage({
    viewport: { width, height },
    reducedMotion: 'no-preference',
  })

  const errors = []
  page.on('console', (msg) => {
    if (msg.type() === 'error') errors.push(msg.text())
  })
  page.on('pageerror', (err) => errors.push(err.message))

  await page.goto(url, { waitUntil: 'networkidle' })
  await page.waitForTimeout(400)
  await page.screenshot({
    path: path.join(out, `${name}.png`),
    fullPage: true,
  })

  if (errors.length) {
    await import('node:fs/promises').then(({ writeFile }) =>
      writeFile(path.join(out, `${name}-errors.txt`), errors.join('\n'))
    )
  }

  await page.close()
}

const reduced = await browser.newPage({
  viewport: { width: 1440, height: 1000 },
  reducedMotion: 'reduce',
})
await reduced.goto(url, { waitUntil: 'networkidle' })
await reduced.screenshot({
  path: path.join(out, 'desktop-reduced-motion.png'),
  fullPage: true,
})
await reduced.close()

await browser.close()
console.log(`Captured design review screenshots in ${out}`)
