#!/usr/bin/env node
import { chromium } from 'playwright'
import { mkdir } from 'node:fs/promises'
import path from 'node:path'

const [url, outDir='artifacts/reference', widthArg='1440', heightArg='1000', dprArg='1'] = process.argv.slice(2)
if (!url) {
  console.error('Usage: capture-reference <url> [outDir] [width] [height] [dpr]')
  process.exit(2)
}
const width = Number(widthArg), height = Number(heightArg), deviceScaleFactor = Number(dprArg)
await mkdir(outDir, { recursive:true })

const browser = await chromium.launch({ headless:true })
const context = await browser.newContext({
  viewport:{ width, height },
  deviceScaleFactor,
})
const page = await context.newPage()
await page.goto(url, { waitUntil:'domcontentloaded' })
await page.evaluate(async () => { await document.fonts.ready })
await page.waitForTimeout(300)

await page.screenshot({
  path:path.join(outDir, `reference-${width}x${height}@${deviceScaleFactor}.png`),
  fullPage:true,
  animations:'disabled',
  caret:'hide',
})

console.log(JSON.stringify({
  url, width, height, deviceScaleFactor,
  title: await page.title(),
}, null, 2))

await browser.close()
