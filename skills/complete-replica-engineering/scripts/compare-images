#!/usr/bin/env node
/**
 * Pixel comparison of two PNG screenshots, writing a difference image.
 *
 * The Python original used Pillow. A project sandbox is a
 * `node:22-bookworm-slim` container: no Python, and no Pillow to install into
 * it. Rather than trade one unavailable dependency for an npm one, this
 * decodes and encodes PNG directly on `node:zlib`, which Node already ships —
 * so it runs the moment it is written into a project, with nothing to install.
 *
 * PNG only, and deliberately so: the images this compares come from
 * `capture-reference` and `snapshot-reference`, which are Playwright
 * screenshots, and those are always PNG. Anything else fails loudly rather
 * than guessing, because a comparator that silently misreads its input would
 * report a replica as matching when it does not.
 *
 *   node scripts/compare-images <reference.png> <replica.png> [diff.png]
 *
 * Exit 0 when identical, 1 when they differ, 2 on a usage or format error.
 */
import fs from 'node:fs'
import zlib from 'node:zlib'

const PNG_MAGIC = Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])

/** Decode a PNG to `{ width, height, rgba }`, 4 bytes per pixel. */
function decodePng(file) {
  const buf = fs.readFileSync(file)
  if (!buf.subarray(0, 8).equals(PNG_MAGIC)) throw new Error(`${file} is not a PNG`)

  let width = 0
  let height = 0
  let bitDepth = 0
  let colorType = 0
  let interlace = 0
  let palette = null
  let transparency = null
  const idat = []

  let offset = 8
  while (offset < buf.length) {
    const length = buf.readUInt32BE(offset)
    const type = buf.toString('ascii', offset + 4, offset + 8)
    const data = buf.subarray(offset + 8, offset + 8 + length)
    offset += 12 + length // length + type + data + crc

    if (type === 'IHDR') {
      width = data.readUInt32BE(0)
      height = data.readUInt32BE(4)
      bitDepth = data[8]
      colorType = data[9]
      interlace = data[12]
    } else if (type === 'PLTE') palette = data
    else if (type === 'tRNS') transparency = data
    else if (type === 'IDAT') idat.push(data)
    else if (type === 'IEND') break
  }

  if (bitDepth !== 8) throw new Error(`${file}: only 8-bit PNGs are supported (got bit depth ${bitDepth})`)
  if (interlace !== 0) throw new Error(`${file}: interlaced PNGs are not supported`)
  const CHANNELS = { 0: 1, 2: 3, 3: 1, 4: 2, 6: 4 }
  const channels = CHANNELS[colorType]
  if (!channels) throw new Error(`${file}: unsupported PNG colour type ${colorType}`)
  if (colorType === 3 && !palette) throw new Error(`${file}: indexed PNG with no palette`)

  const raw = zlib.inflateSync(Buffer.concat(idat))
  const stride = width * channels
  const out = Buffer.alloc(height * stride)

  // Undo the per-scanline filters. Each line is prefixed by its filter byte and
  // is predicted from the pixel to its left (a) and the line above (b/c).
  let pos = 0
  for (let y = 0; y < height; y++) {
    const filter = raw[pos++]
    const line = raw.subarray(pos, pos + stride)
    pos += stride
    const target = y * stride
    for (let i = 0; i < stride; i++) {
      const a = i >= channels ? out[target + i - channels] : 0
      const b = y > 0 ? out[target - stride + i] : 0
      const c = i >= channels && y > 0 ? out[target - stride + i - channels] : 0
      let value = line[i]
      if (filter === 1) value += a
      else if (filter === 2) value += b
      else if (filter === 3) value += (a + b) >> 1
      else if (filter === 4) {
        const p = a + b - c
        const pa = Math.abs(p - a)
        const pb = Math.abs(p - b)
        const pc = Math.abs(p - c)
        value += pa <= pb && pa <= pc ? a : pb <= pc ? b : c
      } else if (filter !== 0) throw new Error(`${file}: unknown PNG filter ${filter} on row ${y}`)
      out[target + i] = value & 0xff
    }
  }

  // Normalise every colour type to RGBA so the comparison has one shape.
  const rgba = Buffer.alloc(width * height * 4)
  for (let i = 0, p = 0; i < width * height; i++, p += 4) {
    const s = i * channels
    if (colorType === 0) {
      rgba[p] = rgba[p + 1] = rgba[p + 2] = out[s]
      rgba[p + 3] = 255
    } else if (colorType === 4) {
      rgba[p] = rgba[p + 1] = rgba[p + 2] = out[s]
      rgba[p + 3] = out[s + 1]
    } else if (colorType === 3) {
      const idx = out[s]
      rgba[p] = palette[idx * 3]
      rgba[p + 1] = palette[idx * 3 + 1]
      rgba[p + 2] = palette[idx * 3 + 2]
      rgba[p + 3] = transparency && idx < transparency.length ? transparency[idx] : 255
    } else {
      rgba[p] = out[s]
      rgba[p + 1] = out[s + 1]
      rgba[p + 2] = out[s + 2]
      rgba[p + 3] = colorType === 6 ? out[s + 3] : 255
    }
  }
  return { width, height, rgba }
}

/** Encode RGBA back to a PNG, filter type 0 — this is a diff, not an asset. */
function encodePng(width, height, rgba) {
  const stride = width * 4
  const raw = Buffer.alloc(height * (stride + 1))
  for (let y = 0; y < height; y++) {
    raw[y * (stride + 1)] = 0
    rgba.copy(raw, y * (stride + 1) + 1, y * stride, (y + 1) * stride)
  }
  const chunk = (type, data) => {
    const out = Buffer.alloc(data.length + 12)
    out.writeUInt32BE(data.length, 0)
    out.write(type, 4, 'ascii')
    data.copy(out, 8)
    out.writeUInt32BE(crc32(out.subarray(4, 8 + data.length)), 8 + data.length)
    return out
  }
  const ihdr = Buffer.alloc(13)
  ihdr.writeUInt32BE(width, 0)
  ihdr.writeUInt32BE(height, 4)
  ihdr[8] = 8
  ihdr[9] = 6 // RGBA
  return Buffer.concat([
    PNG_MAGIC,
    chunk('IHDR', ihdr),
    chunk('IDAT', zlib.deflateSync(raw)),
    chunk('IEND', Buffer.alloc(0)),
  ])
}

const CRC_TABLE = (() => {
  const table = new Int32Array(256)
  for (let n = 0; n < 256; n++) {
    let c = n
    for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1
    table[n] = c
  }
  return table
})()
function crc32(buf) {
  let c = 0xffffffff
  for (let i = 0; i < buf.length; i++) c = CRC_TABLE[(c ^ buf[i]) & 0xff] ^ (c >>> 8)
  return (c ^ 0xffffffff) >>> 0
}

const [refPath, repPath, diffPath = 'visual-diff.png'] = process.argv.slice(2)
if (!refPath || !repPath) {
  console.error('Usage: compare-images <reference.png> <replica.png> [diff.png]')
  process.exit(2)
}

let a
let b
try {
  a = decodePng(refPath)
  b = decodePng(repPath)
} catch (error) {
  console.error(error.message)
  process.exit(2)
}

if (a.width !== b.width || a.height !== b.height) {
  console.log(JSON.stringify({
    match: false,
    reason: 'size_mismatch',
    reference: [a.width, a.height],
    replica: [b.width, b.height],
  }, null, 2))
  process.exit(1)
}

const pixels = a.width * a.height
const diff = Buffer.alloc(pixels * 4)
let changed = 0
let sumSq = 0
for (let i = 0; i < pixels; i++) {
  const p = i * 4
  const dr = Math.abs(a.rgba[p] - b.rgba[p])
  const dg = Math.abs(a.rgba[p + 1] - b.rgba[p + 1])
  const db = Math.abs(a.rgba[p + 2] - b.rgba[p + 2])
  const da = Math.abs(a.rgba[p + 3] - b.rgba[p + 3])
  diff[p] = dr
  diff[p + 1] = dg
  diff[p + 2] = db
  diff[p + 3] = da
  if (dr || dg || db) changed++
  sumSq += dr * dr + dg * dg + db * db
}
// Any non-zero channel means "not identical", alpha included.
//
// This DELIBERATELY differs from the Python original, which asked Pillow for
// `ImageChops.difference(a, b).getbbox()`. On an RGBA image `getbbox()` is
// driven by the alpha channel, and two opaque screenshots differing only in
// colour produce a difference image whose alpha is uniformly zero — so it
// returned None and the script reported `"match": true` with exit 0 for a
// replica that visibly did not match. Screenshots are always opaque, so that
// fired on essentially every real comparison: the metrics were right and the
// verdict was wrong. Verified against Pillow before changing it.
const identical = changed === 0 && !diff.some((v, i) => i % 4 === 3 && v !== 0)

fs.writeFileSync(diffPath, encodePng(a.width, a.height, diff))
console.log(JSON.stringify({
  match: identical,
  width: a.width,
  height: a.height,
  changed_pixels: changed,
  changed_ratio: pixels ? changed / pixels : 0,
  rgb_rmse: pixels ? Math.sqrt(sumSq / (pixels * 3)) : 0,
  diff_path: diffPath,
}, null, 2))
process.exit(identical ? 0 : 1)
