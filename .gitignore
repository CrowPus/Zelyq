# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Runtime data
workspace/
data/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Test / coverage
coverage/
.nyc_output/

# Python bytecode cache — the senior-software-engineering skill's own
# scripts/project-audit is Python; nothing else in this repo runs it,
# so there was no existing rule for its cache directory.
__pycache__/
*.pyc

# Private working notes — not part of the open-source project
docs/co-founders/
multi-agents/

# Design reference library (see proposal 056). The bundled, first-party
# `design-md/_archetypes/` set and `design-md/Agent.md` are the only design
# refs that ship; a dropped-in third-party library (getdesign.md etc.) is
# operator-provided via ZELYQ_DESIGN_REFS_DIR and never committed.
design-md/*
!design-md/_archetypes/
!design-md/Agent.md
!design-md/README.md

# Eval harness output
apps/agent/evals/results/

# Playwright
test-results/
playwright-report/

# Playwright's own throwaway server
.playwright/
.codex
