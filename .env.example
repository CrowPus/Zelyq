# ---------------------------------------------------------------------------
# Zelyq configuration. Copy to .env and edit. Every value here is a default;
# an unset variable falls back to what is shown.
#
# Most of these can also be set in Settings, in the app, by an instance
# administrator — nobody has to edit this file. Anything set HERE wins, and the
# settings screen shows it as locked, so the two never disagree silently.
# ---------------------------------------------------------------------------

# --- Secrets ----------------------------------------------------------------
# 32-byte key encrypting API keys stored through the settings screen, as base64
# or 64 hex characters. Leave unset and one is generated beside the database at
# data/secret.key — fine for a laptop, but on a server prefer setting it here
# from a secret manager, so the key does not sit next to what it protects.
# Losing it does not lose the instance: stored API keys are re-entered.
ZELYQ_SECRET_KEY=
# ZELYQ_SECRET_KEY_FILE=./data/secret.key

# --- Model access (required) -----------------------------------------------
# Which vendor the agent talks to:
#   anthropic | google | openai | deepseek | mistral | xai | groq | openrouter | custom
ZELYQ_PROVIDER=anthropic

# Set the key for whichever provider you use. Only the selected one is needed.
# Claude:     https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only for an identity-linked (workspace-scoped) Claude key: the Messages API
# rejects such a key unless the request also names its workspace. Leave blank
# for an ordinary account-level key.
ANTHROPIC_WORKSPACE_ID=
# Gemini:     https://aistudio.google.com/apikey  (GOOGLE_API_KEY also works)
GEMINI_API_KEY=
# OpenAI:     https://platform.openai.com/api-keys
OPENAI_API_KEY=
# DeepSeek:   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Mistral:    https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Grok/xAI:   https://console.x.ai
XAI_API_KEY=
# Groq:       https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Voice input ------------------------------------------------------------
# The microphone button records in the browser and sends the finished clip to
# the server for transcription. Provider and model are also editable in
# Settings. OpenAI voice input uses OPENAI_API_KEY above; a Codex/ChatGPT
# subscription session is not an API key for this endpoint.
ZELYQ_SPEECH_PROVIDER=openai
ZELYQ_SPEECH_MODEL=whisper-1

# --- Plugin tools ---------------------------------------------------------
# The repo ships a `plugins/` directory of extra agent tools (GitHub, Stripe,
# Supabase, Figma, Vercel, Netlify, Cloudflare, Sentry, container/database
# inspectors, and more — ~70 tools). They are NOT loaded unless you point this
# at a directory, because a plugin is executable code that runs in the agent
# process — as trusted as whoever configures this instance. Set it to the
# bundled set to turn them on, or to your own directory. Loaded once at boot;
# see docs/plugins.md.
# ZELYQ_PLUGIN_DIR=./plugins

# --- Design references -----------------------------------------------------
# The repo ships a `design-md/` library: one folder per reference, each a real
# product's design language (tokens + prose), plus `Agent.md` (a UI-craft
# checklist). The Architect picks the closest reference to base a project's
# DESIGN.md on. Point this at your own directory to add to or override it
# (your entries win on a slug collision).
# ZELYQ_DESIGN_REFS_DIR=/path/to/your/design-refs

# --- Reference images ----------------------------------------------------------
# The `fetch_reference_image` tool searches a stock-photo service, downloads the
# top hit into the project, and shows it to the agent so it can confirm the
# subject before writing a caption — instead of guessing a photo ID from memory.
# Default provider is keyless Openverse (Creative-Commons media). For Unsplash or
# Pexels quality, set both:
#   ZELYQ_IMAGE_PROVIDER=unsplash   (or: pexels, openverse)
#   ZELYQ_IMAGE_PROVIDER_KEY=...    (Unsplash "Access Key" / Pexels API key)
# With ZELYQ_CONTAINER_EGRESS_ALLOWLIST set, also allow the provider's hosts:
#   openverse -> api.openverse.org
#   unsplash  -> api.unsplash.com, images.unsplash.com
#   pexels    -> api.pexels.com, images.pexels.com
# Unset = Openverse, no key. No provider reachable = a labelled placeholder.
ZELYQ_IMAGE_PROVIDER=
ZELYQ_IMAGE_PROVIDER_KEY=

# --- Your own model, on your own network ------------------------------------
# ZELYQ_PROVIDER=custom points Zelyq at any OpenAI-compatible endpoint, so the
# contents of your project never leave your network. Ollama, vLLM, LM Studio,
# or a gateway of your own.
#
#   ZELYQ_PROVIDER=custom
#   ZELYQ_MODEL_BASE_URL=http://localhost:11434/v1
#   ZELYQ_MODEL=qwen3-coder:30b
#
# Plaintext http is refused unless the address is on this machine: everything
# the agent reads would otherwise cross the network unencrypted.
ZELYQ_MODEL_BASE_URL=
# Only if your endpoint requires one. Most self-hosted servers do not.
ZELYQ_MODEL_API_KEY=

# Model override. Leave blank to use the provider's default:
#   anthropic  -> claude-opus-5
#   google     -> gemini-2.5-pro
#   openai     -> gpt-5.2
#   deepseek   -> deepseek-v4-flash
#   mistral    -> mistral-large-latest
#   xai        -> grok-4.6
#   openrouter -> anthropic/claude-sonnet-4.6
#   groq       -> llama-3.3-70b-versatile
#   custom     -> no default; set this to the exact name the vendor reports
ZELYQ_MODEL=

# Reasoning depth: low | medium | high | xhigh | max
# Gemini has no level above "high", so xhigh and max map onto it.
ZELYQ_EFFORT=high

# Anthropic-only server-side features. Off by default. Each is a beta — set to 1
# only after one live turn has confirmed the API accepts it on your model.
#   ZELYQ_CONTEXT_EDITING=1   the API drops old tool inputs/results from the
#                             request before the model sees them (keeps the
#                             recent window) — cuts the cost of a long build
#   ZELYQ_REFUSAL_FALLBACK=1  a policy-declined request retries on a fallback
#                             model in the same call instead of ending
# ZELYQ_CONTEXT_EDITING=1
# ZELYQ_REFUSAL_FALLBACK=1

# --- Prompt caching ---------------------------------------------------------
# Most of what an agent turn costs is the SAME text sent again on every step:
# the system prompt, the tool list, and the transcript so far. Every provider
# that can charge less for a repeated prefix is used automatically — these two
# only exist for the cases where you need to override that. Neither has to be
# set; the defaults are what you want.

# Gemini: pin the system prompt + tool list server-side with an explicit cache.
# OFF, and almost certainly should stay off. An explicit cache SUPPRESSES
# Gemini's own implicit caching of everything outside it, and implicit caching
# is better at this job. Measured on gemini-3.7-flash, steady state, over one
# ~70,000-token conversation:
#   implicit caching only ............ 4,768 tokens billed in full
#   explicit cache, prefix + history . 19,252
#   explicit cache, prefix only ...... 57,740
# Turn it on only for a model with no implicit caching, and verify with two
# identical requests in a row — a single cold request will mislead you.
# ZELYQ_GEMINI_EXPLICIT_CACHE=1

# Anthropic: how long a cached prefix is kept. "auto" (the default) starts at
# Anthropic's 5-minute lifetime and switches to the 1-hour one for the rest of
# the session the first time it sees a gap long enough to have expired the
# short one — an install, a long build, or you reading a plan before replying.
# The 1-hour cache costs more to write and the same to read, so this is a bet
# the session makes for itself from what it has observed. Pin it to 5m or 1h
# only for a controlled measurement.
# ZELYQ_CACHE_TTL=auto

# --- MCP servers ------------------------------------------------------------
# Tools another application exposes over the Model Context Protocol. Zelyq
# connects at boot, asks each server what it has, and hands those tools to the
# agent alongside its own.
#
# Point this at a JSON file in the `mcpServers` shape other MCP clients use.
# Both a local process and a hosted endpoint work:
#
#   {
#     "mcpServers": {
#       "files":  { "command": "npx",
#                   "args": ["-y", "@modelcontextprotocol/server-filesystem", "/srv/data"] },
#       "github": { "url": "https://api.githubcopilot.com/mcp/",
#                   "headers": { "Authorization": "Bearer ghp_..." } }
#     }
#   }
#
# Read once at boot, never re-scanned, never reachable from Settings and never
# read from a project's own directory — the rules plugins follow, so a cloned
# repository cannot pick the tools of the agent reading it. `"disabled": true`
# skips an entry. Tool names are namespaced (`github__list_issues`), so an MCP
# server cannot take a built-in's name. What a server returns is treated as
# untrusted data. A server that is down costs its tools, not the agent's boot.
#
# MIND THE SCOPE. A server has whatever access you gave it and does NOT inherit
# Zelyq's project boundary: this config is instance-wide, a session is not. A
# filesystem server pointed at `workspace/` lets an agent on one project read
# and write every other project on the instance. The same goes for any server
# holding a token — it reaches whatever that token reaches, from every project.
# ZELYQ_MCP_CONFIG=./data/mcp.json

# --- Processes --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# API + WebSocket gateway
ZELYQ_SERVER_HOST=127.0.0.1
ZELYQ_SERVER_PORT=8787

# Agent runtime
ZELYQ_AGENT_HOST=127.0.0.1
ZELYQ_AGENT_PORT=8788
ZELYQ_AGENT_URL=http://127.0.0.1:8788

# Dev server bind address for the web UI. Use 0.0.0.0 to reach it from another
# machine (a VM or remote host); 127.0.0.1 keeps it local only.
ZELYQ_WEB_HOST=127.0.0.1

# Browser origin allowed to call the API (comma-separated)
ZELYQ_CORS_ORIGIN=http://localhost:5173

# --- Accounts ---------------------------------------------------------------
# Whether new people may sign themselves up. The FIRST account is always
# allowed — that is how the instance is set up — and becomes the owner.
# Set this to false once your accounts exist on anything internet-reachable,
# and add people through the team screen instead.
ZELYQ_ALLOW_REGISTRATION=true

# How long a sign-in lasts, in days.
ZELYQ_SESSION_TTL_DAYS=30

# Single sign-on. Disabled unless all four are set — see docs/configuration.md.
ZELYQ_OIDC_ISSUER=
ZELYQ_OIDC_CLIENT_ID=
ZELYQ_OIDC_CLIENT_SECRET=
ZELYQ_OIDC_REDIRECT_URI=

# Supabase integration. Optional. The connection is managed in
# Settings by the instance admin; the credential is encrypted at rest and never
# reaches a generated project or the agent — previews get only the public URL +
# publishable key. Set a client id + secret ONLY if you registered a Supabase
# OAuth *application* (not a project API key); otherwise the pasted Personal
# Access Token path is used. NEVER put a real value in this file.
ZELYQ_SUPABASE_OAUTH_CLIENT_ID=
ZELYQ_SUPABASE_OAUTH_CLIENT_SECRET=
# Defaults to <ZELYQ_PUBLIC_URL>/api/integrations/supabase/oauth/callback.
ZELYQ_SUPABASE_OAUTH_REDIRECT_URL=
# Domain for the throwaway user "Apply & verify" signs up. Supabase rejects
# domains with no MX records (example.com among them) — set one that resolves.
ZELYQ_SUPABASE_VERIFY_EMAIL_DOMAIN=

# --- Figma (/figma <link>) ------------------------------------------------
# Register a Figma OAuth app at figma.com -> Settings -> Account -> OAuth apps,
# then set the client id + secret here (or in Settings). Both set: the composer
# offers `/figma <frame-link>` and a per-user "Connect Figma" card appears in
# Settings. Each user's OAuth token is encrypted at rest and used only
# in-process on the server to read their Figma files — it never reaches a
# generated project or the agent. Read-only scopes. NEVER put a real value here.
ZELYQ_FIGMA_CLIENT_ID=
ZELYQ_FIGMA_CLIENT_SECRET=
# Defaults to <ZELYQ_PUBLIC_URL>/api/integrations/figma/oauth/callback.
# Must match the redirect URL registered on the Figma app.
ZELYQ_FIGMA_REDIRECT_URL=
# Set false to hide `/figma` and refuse extraction even when an app is set.
ZELYQ_FIGMA_ENABLED=true

# --- Cloning a live site (/clone <url>) ----------------------------------
# `/clone` visits a URL with a headless browser and rebuilds it in the project.
# Its SSRF guard (blocks private / loopback / link-local / metadata addresses,
# re-checks every redirect) is always on and has no switch. Set false to
# disable the feature entirely.
ZELYQ_CLONE_ENABLED=true

# --- Storage ----------------------------------------------------------------
# SQLite (local): file:./data/zelyq.db  — a relative file: path is resolved
#   against the repo root, so the server, the agent, and `pnpm db:migrate` all
#   land on the same file regardless of which package directory they run from.
# PostgreSQL (cloud): postgres://user:pass@host:5432/zelyq
DATABASE_URL=file:./data/zelyq.db

# Where project files live in local mode. A relative path is resolved against
# the repo root (not the process cwd), so the server and the agent share it.
ZELYQ_WORKSPACE_DIR=./workspace

# --- Execution --------------------------------------------------------------
# local     = run project commands as child processes on this machine
# container = the same, with agent shell commands jailed per project
# remote    = delegate to a runtime host (required for shared deployments)
ZELYQ_RUNTIME=local

# --- Running agent commands and the preview in a container ------------------
# ZELYQ_RUNTIME=container is `local` with agent shell commands and the dev
# server jailed: one container per project, that project bind-mounted and
# nothing else from the host, no reachability between two projects' containers.
# Needs docker (or podman) installed.
#
# The cloud metadata endpoint (169.254.169.254) is blocked by default — set
# ZELYQ_CONTAINER_BLOCK_METADATA=false to disable. Outbound access to anything
# else is NOT filtered by default, so this is not yet a complete sandbox. See
# docs/configuration.md.
ZELYQ_CONTAINER_IMAGE=
ZELYQ_CONTAINER_MEMORY=
ZELYQ_CONTAINER_CPUS=
ZELYQ_CONTAINER_ENGINE=
ZELYQ_CONTAINER_BLOCK_METADATA=

# Opt-in general egress filtering: comma-separated hostnames project
# containers may reach; everything else is default-denied. Unset (the
# default): egress is unfiltered, as above. There is no Zelyq-maintained
# default list — the addresses behind a name like registry.npmjs.org change
# constantly, so this is yours to name and maintain, not ours to guess.
# Refreshed every five minutes; a project reaching for something you did not
# list fails fast rather than hanging. See docs/configuration.md.
#   ZELYQ_CONTAINER_EGRESS_ALLOWLIST=registry.npmjs.org,github.com
ZELYQ_CONTAINER_EGRESS_ALLOWLIST=

# Remote runtime settings (ZELYQ_RUNTIME=remote)
ZELYQ_RUNTIME_URL=
ZELYQ_RUNTIME_TOKEN=

# Port range handed out to project dev servers in local mode.
ZELYQ_PREVIEW_PORT_MIN=4300
ZELYQ_PREVIEW_PORT_MAX=4399

# Decides whether project dev servers accept connections from outside this
# machine. Keep 127.0.0.1 when you browse from the same machine. On a VM or a
# remote host, set this to any non-loopback value (your browser's address is
# a sensible one) or previews will refuse every connection but their own —
# anything other than loopback makes dev servers listen on all interfaces, so
# open only the preview ports you intend to expose.
#
# The web UI works out the address it shows and loads a running preview at
# from the browser's own location, not from this variable, so it no longer
# has to be the exact right value for previews to load in the app. It is
# still what a non-browser caller of the API (a script, curl) gets back.
ZELYQ_PREVIEW_HOST=127.0.0.1

# Optional. For a deployment that reverse-proxies each preview over one HTTPS
# origin instead of exposing the raw 4300-4399 range — the right call behind a
# real domain with HSTS, where a plain http://host:port preview URL would be
# blocked. Set it to a template with a `{port}` placeholder and point a
# wildcard vhost at 127.0.0.1:<port>, e.g.:
#   ZELYQ_PREVIEW_URL_TEMPLATE=https://p{port}.preview.example.com
# Then `*.preview.example.com` needs a DNS record and a wildcard TLS cert, and
# nginx maps `p<port>.preview.example.com` -> `http://127.0.0.1:<port>`. See
# docs/self-hosting.md. Unset: previews use `http://<ZELYQ_PREVIEW_HOST>:<port>`.
ZELYQ_PREVIEW_URL_TEMPLATE=

# Hard ceiling for a single agent shell command, in milliseconds.
ZELYQ_EXEC_TIMEOUT_MS=120000
