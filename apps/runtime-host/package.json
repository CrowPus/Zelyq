{
  "name": "@zelyq/runtime-host",
  "version": "0.1.0",
  "description": "Reference Zelyq runtime host — serves docs/runtime-protocol.md over HTTP.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@zelyq/core": "workspace:*",
    "@zelyq/runtime": "workspace:*",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
