{
  "name": "@zelyq/server",
  "version": "0.1.0",
  "description": "Zelyq API server — projects, files, previews, and the browser WebSocket gateway.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@zelyq/core": "workspace:*",
    "@zelyq/db": "workspace:*",
    "@zelyq/runtime": "workspace:*",
    "@zelyq/tools": "workspace:*",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "0.35.5",
    "ssh2": "^1.17.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
