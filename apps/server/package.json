{
  "name": "@zelyq/server",
  "version": "0.1.0",
  "description": "Zelyq API server — projects, files, previews, and the browser WebSocket gateway.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "admin-key": "tsx src/admin-key-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/lib-storage": "3.1176.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/reply-from": "^12.9.1",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "@google/genai": "2.21.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@zelyq/core": "workspace:*",
    "@zelyq/db": "workspace:*",
    "@zelyq/runner": "workspace:*",
    "@zelyq/runtime": "workspace:*",
    "@zelyq/tools": "workspace:*",
    "fast-xml-parser": "^5.12.1",
    "fastify": "^5.12.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "nodemailer": "10.6.1",
    "sharp": "0.35.5",
    "ssh2": "^1.17.0",
    "tldts": "7.5.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "6.4.17",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  }
}
