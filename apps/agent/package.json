{
  "name": "@zelyq/agent",
  "version": "0.1.0",
  "description": "Zelyq agent runtime — runs the model loop and executes tools against a project.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p evals/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "tsx evals/run.ts",
    "check:prompt-hash": "tsx scripts/check-prompt-hash.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@fastify/cors": "^11.3.0",
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zelyq/core": "workspace:*",
    "@zelyq/db": "workspace:*",
    "@zelyq/runtime": "workspace:*",
    "@zelyq/tools": "workspace:*",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
