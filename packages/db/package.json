{
  "name": "@zelyq/db",
  "version": "0.1.0",
  "description": "Zelyq persistence — Drizzle schema, migrations, and repositories for SQLite and PostgreSQL.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate --config drizzle.sqlite.config.ts && drizzle-kit generate --config drizzle.pg.config.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@zelyq/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
