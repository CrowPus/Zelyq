{
  "name": "zelyq",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI app builder — describe an app, watch an agent build it, edit it live.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/CrowPus/Zelyq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowPus/Zelyq.git"
  },
  "bugs": {
    "url": "https://github.com/CrowPus/Zelyq/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @zelyq/server dev",
    "dev:agent": "pnpm --filter @zelyq/agent dev",
    "dev:web": "pnpm --filter @zelyq/web dev",
    "start": "pnpm --filter @zelyq/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @zelyq/db generate",
    "db:migrate": "pnpm --filter @zelyq/db migrate",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache && rm -rf node_modules",
    "eval": "pnpm --filter @zelyq/agent eval"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
