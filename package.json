{
  "name": "zelyq",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI app builder \u2014 describe an app, watch an agent build it, edit it live.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/CrowPus/Zelyq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrowPus/Zelyq.git"
  },
  "bugs": {
    "url": "https://github.com/CrowPus/Zelyq/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.12.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm -r --filter \"./packages/**\" build && node scripts/dev.mjs",
    "dev:server": "pnpm --filter @zelyq/server dev",
    "dev:agent": "pnpm --filter @zelyq/agent dev",
    "dev:web": "pnpm --filter @zelyq/web dev",
    "start": "pnpm --filter @zelyq/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @zelyq/db generate",
    "db:migrate": "pnpm --filter @zelyq/db migrate",
    "db:backup": "pnpm --filter @zelyq/db backup",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache && rm -rf node_modules",
    "eval": "pnpm --filter @zelyq/agent eval",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "fast-uri@>=3.1.3 <3.1.6": "^3.1.6",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "fast-uri@>=3.1.2 <3.1.6": "^3.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": ">=5.0.11",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "fast-copy@>=4.0.0 <4.1.0": "^4.1.0",
      "fast-uri@>=4.0.0 <4.2.3": "^4.2.3",
      "fastify@>=5.12.2 <5.12.6": "^5.12.6",
      "hono@<4.13.11": "^4.13.11",
      "ip-address@<10.7.4": "^10.7.4",
      "vite@>=8.2.0 <8.2.4": "^8.2.4",
      "zod@<4.6.6": "^4.6.6"
    }
  }
}
